# template — placeholders filled in by install-kiosk.sh; do not `systemctl link` this file directly
[Unit]
Description=Toernooi TV kiosk (cage + Chromium fullscreen on HDMI)
After=toernooitv-server.service systemd-user-sessions.service getty@tty1.service
Wants=toernooitv-server.service
Conflicts=getty@tty1.service

[Service]
User=__USER__
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=XDG_SEAT=seat0
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/usr/bin/cage -- __APP__/appliance/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
